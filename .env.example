# 環境変数サンプル — cp .env.example .env して実値を設定
# DATABASE_URL=<Neon接続文字列（pooler 推奨）>
# SESSION_SECRET=<openssl rand -hex 32 で生成>
# CLOUDFLARE_ACCOUNT_ID=<CloudflareアカウントID>
# CLOUDFLARE_API_TOKEN=<Workers Scripts: Edit 権限トークン>
# SEED_DEMO_PASSWORD=<デモユーザー初期パスワード（本番seed時は必須）>
DATABASE_URL=
SESSION_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SEED_DEMO_PASSWORD=
